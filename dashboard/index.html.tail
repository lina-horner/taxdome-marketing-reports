/* ---------- LEADS TAB: Online vs Offline monthly ---------- */
function renderOnlineOfflineChart() {
  // Jan–Mar 2026: live HubSpot online totals + offline totals from user. Offline
  // ICP/Non-ICP split estimated at 32% ICP (quarter-level proxy) until verified
  // with RevOps. April 2026: partial through Apr 21; all four segments are
  // verified values so totals match the OKR chart's "Classified leads (Q2 total)".
  const months      = ['Jan 2026', 'Feb 2026', 'Mar 2026', 'Apr 2026*'];
  const onlineIcp   = [ 479,         482,         538,         257       ];
  const onlineNicp  = [ 1033,        854,         1210,        559       ];
  const offlineIcp  = [ 459,         873,         841,         366       ];
  const offlineNicp = [ 976,         1856,        1786,        36        ];
  const monthTotal  = onlineIcp.map((_, i) => onlineIcp[i] + onlineNicp[i] + offlineIcp[i] + offlineNicp[i]);

  const traces = [
    { type: 'bar', name: 'Online — ICP',    x: months, y: onlineIcp,  marker: { color: '#1864AB' }, hovertemplate: '<b>%{x}</b><br>Online ICP: %{y}<extra></extra>' },
    { type: 'bar', name: 'Online — Non-ICP',x: months, y: onlineNicp, marker: { color: '#74C0FC' }, hovertemplate: '<b>%{x}</b><br>Online Non-ICP: %{y}<extra></extra>' },
    { type: 'bar', name: 'Offline — ICP',   x: months, y: offlineIcp, marker: { color: '#495057' }, hovertemplate: '<b>%{x}</b><br>Offline ICP: %{y}<extra></extra>' },
    { type: 'bar', name: 'Offline — Non-ICP',x: months, y: offlineNicp,marker: { color: '#ADB5BD' }, hovertemplate: '<b>%{x}</b><br>Offline Non-ICP: %{y}<extra></extra>' }
  ];

  const layout = {
    height: 420,
    margin: { l: 60, r: 20, t: 10, b: 80 },
    paper_bgcolor: 'rgba(0,0,0,0)',
    plot_bgcolor: 'rgba(0,0,0,0)',
    font: { family: 'Inter, sans-serif', color: getComputedStyle(document.body).getPropertyValue('--text') },
    barmode: 'stack',
    xaxis: { tickfont: { size: 12 }, showgrid: false },
    yaxis: { gridcolor: 'rgba(128,128,128,0.15)', title: { text: 'Marketing Leads', font: { size: 12 } } },
    legend: { orientation: 'h', y: -0.18, x: 0.5, xanchor: 'center', font: { size: 11 } },
    bargap: 0.35,
    annotations: monthTotal.map((t, i) => ({
      x: months[i], y: t, yshift: 14, text: `<b>${t.toLocaleString()}</b>`,
      showarrow: false, font: { size: 12, color: getComputedStyle(document.body).getPropertyValue('--text') }
    }))
  };

  Plotly.newPlot('chartOnlineOffline', traces, layout, { displayModeBar: false, responsive: true });
}

/* ---------- LEADS TAB: 12-month online trend ---------- */
function renderLeadsTrendChart() {
  // Live HubSpot data — monthly companies created where icp__nonicp IN ('ICP','Non-ICP')
  // AND hs_analytics_source != OFFLINE. May 2025 → Apr 2026 (Apr partial through Apr 20).
  const months = ['May 2025','Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan 2026','Feb','Mar','Apr*'];
  const icp    = [  369,      398, 391, 363, 448, 448, 409, 496, 479,       482,   538, 257  ];
  const nicp   = [  574,      521, 660, 791, 703, 817,1050,1150,1033,       854,  1210, 559  ];
  const total  = icp.map((v, i) => v + nicp[i]);

  // 3-month trailing moving average on total
  const ma3 = total.map((_, i) => {
    const s = Math.max(0, i - 2);
    const slice = total.slice(s, i + 1);
    return Math.round(slice.reduce((a,b) => a+b, 0) / slice.length);
  });

  const traces = [
    {
      type: 'bar', name: 'ICP', x: months, y: icp,
      marker: { color: COLORS.primary }, hovertemplate: '<b>%{x}</b><br>ICP: %{y}<extra></extra>'
    },
    {
      type: 'bar', name: 'Non-ICP', x: months, y: nicp,
      marker: { color: '#ADB5BD' },
      text: total.map(t => t.toLocaleString()), textposition: 'outside',
      textfont: { size: 11, color: getComputedStyle(document.body).getPropertyValue('--text') },
      hovertemplate: '<b>%{x}</b><br>Non-ICP: %{y}<extra></extra>'
    },
    {
      type: 'scatter', mode: 'lines+markers', name: '3-month MA (total)',
      x: months, y: ma3,
      line: { color: COLORS.warning, width: 3, shape: 'spline' },
      marker: { size: 6, color: COLORS.warning },
      hovertemplate: '<b>%{x}</b><br>3mo MA: %{y}<extra></extra>'
    }
  ];

  const layout = {
    height: 420,
    margin: { l: 60, r: 20, t: 10, b: 60 },
    paper_bgcolor: 'rgba(0,0,0,0)',
    plot_bgcolor: 'rgba(0,0,0,0)',
    font: { family: 'Inter, sans-serif', color: getComputedStyle(document.body).getPropertyValue('--text') },
    barmode: 'stack',
    xaxis: { tickfont: { size: 11 }, showgrid: false },
    yaxis: { gridcolor: 'rgba(128,128,128,0.15)', title: { text: 'Online Marketing Leads', font: { size: 12 } } },
    legend: { orientation: 'h', y: -0.18, x: 0.5, xanchor: 'center', font: { size: 11 } },
    bargap: 0.25
  };

  Plotly.newPlot('chartLeadsTrend', traces, layout, { displayModeBar: false, responsive: true });
}

/* ---------- MQL TAB ---------- */
function renderMQLKPIs() {
  // Live HubSpot — list 6894 + hs_v2_date_entered_marketingqualifiedlead + lifecyclestage HAS_PROPERTY.
  // W29 (Jul 7-13): 164 total (41 ICP / 120 Non-ICP / 3 No Value). W28 prior (Jun 30-Jul 6): 208.
  // Jul MTD (Jul 1-13, list 6894): 338 total (123 ICP / 206 Non-ICP / 9 No Value).
  const cards = [
    {
      name: 'Total MQL — This Week', value: 164, suffix: '',
      compare: 'Prior wk (W28): 208 &nbsp;·&nbsp; <b style="color:var(--danger)">−21.2% WoW ↓</b> &nbsp;·&nbsp; <span style="color:var(--muted)">YoY: methodology change</span>',
      foot: 'List 6894 · hs_v2_date_entered_marketingqualifiedlead in W29 (Jul 7–13) · ICP 41 / Non-ICP 120 / No Value 3',
      cls: 'red'
    },
    {
      name: 'ICP Share of MQL', value: 26, suffix: '%',
      compare: 'Prior wk: 48% &nbsp;·&nbsp; <b style="color:var(--danger)">−23.0 pp WoW ↓</b> &nbsp;·&nbsp; below 35% target',
      foot: '41 ICP / 161 classified (25.5%) this week · target 35% — below target',
      cls: 'red'
    },
    {
      name: 'Jul MTD MQL', value: 338, suffix: '',
      compare: 'Jul target: 1,415 &nbsp;·&nbsp; <span class="pct">23.9%</span> achieved · pace 42% &nbsp;·&nbsp; <b style="color:var(--danger)">57% of pace</b> &nbsp;·&nbsp; <span style="color:var(--muted)">YoY: N/A</span>',
      foot: 'List 6894 · entered MQL Jul 1–13 · ICP 123 / Non-ICP 206 / No Value 9',
      cls: 'red'
    }
  ];
  const row = document.getElementById('mqlKpiRow');
  row.innerHTML = '';
  cards.forEach(c => {
    const el = document.createElement('div');
    el.className = `kpi-card ${c.cls}`;
    el.innerHTML = `
      <div class="kpi-name">${c.name}</div>
      <div class="kpi-value">${c.value.toLocaleString()}${c.suffix}</div>
      <div class="kpi-compare ${c.cls}">${c.compare}</div>
      <div style="font-size:10px; margin-top:4px; color:var(--muted); font-weight:400; font-style:italic;">${c.foot}</div>
      <div><span class="badge live">Live — HubSpot</span></div>
    `;
    row.appendChild(el);
  });
}
